# Local Postgres for dev — run `docker compose up -d` (see docker-compose.yml), then use:
DATABASE_URL="postgresql://habits:habits@localhost:5433/habits?schema=public"

# Direct (non-pooled) connection — `prisma migrate` can't run through a pooler.
# Locally it's the same database as above.
DIRECT_URL="postgresql://habits:habits@localhost:5433/habits?schema=public"

# In production both point at Supabase: DATABASE_URL through the pooler (port
# 6543, transaction mode) for runtime, DIRECT_URL at the direct connection
# (port 5432) so migrations can run.
#
# Note connection_limit: this is a long-running container, not a serverless
# function, so it must NOT be 1 — a single connection serialises every
# concurrent request and makes them time out under load. Keep it in line with
# the pooler's pool size.
# DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@[POOLER_HOST]:5432/postgres"

# Supabase project URL (Project Settings → API → Project URL), e.g. https://xxxxxxxx.supabase.co
# Used to build the JWKS endpoint for verifying Supabase-issued JWTs.
SUPABASE_URL="https://xxxxxxxx.supabase.co"

# Expected `aud` claim on Supabase JWTs — "authenticated" for logged-in users (Supabase default).
SUPABASE_JWT_AUDIENCE="authenticated"

PORT=3001

# Frontend origin allowed to call this API (CORS). Defaults to the Vite dev
# server if unset; override for production.
# CORS_ORIGIN="http://localhost:5173"
